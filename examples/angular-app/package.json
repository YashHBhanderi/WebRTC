{
  "name": "spreewe-angular-example",
  "version": "0.0.0",
  "private": true,
  "description": "A separate (third-party style) Angular app that integrates SpreeWe chat + calling through @spreewe/chat-sdk and @spreewe/chat-angular",
  "scripts": {
    "start": "ng serve --ssl true --port 4300 --proxy-config proxy.conf.js",
    "build": "ng build"
  },
  "dependencies": {
    "@angular/common": "16.2.12",
    "@angular/compiler": "16.2.12",
    "@angular/core": "16.2.12",
    "@angular/forms": "16.2.12",
    "@angular/platform-browser": "16.2.12",
    "@clerk/clerk-js": "^6.38.1",
    "@matrix-org/matrix-sdk-crypto-wasm": "18.9.0",
    "@spreewe/chat-angular": "file:../../packages/chat-angular/dist",
    "@spreewe/chat-sdk": "file:../../packages/chat-sdk",
    "mediasoup-client": "^3.23.1",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.0",
    "@angular/cli": "~16.2.0",
    "@angular/compiler-cli": "16.2.12",
    "typescript": "~5.1.3"
  }
}
