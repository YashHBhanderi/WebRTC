{
  "name": "@spreewe/core",
  "version": "0.1.0",
  "description": "SpreeWe client core: authentication (OAuth 2.0 + PKCE, backend token exchange, session tokens), REST client, Socket.IO connection management and shared types. Framework-agnostic, no UI.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
