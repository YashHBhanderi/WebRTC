{
  "name": "@spreewe/calls",
  "version": "0.1.0",
  "description": "SpreeWe audio/video calling: call client (signaling + mediasoup media) and UI (incoming call, call view, controls, participants).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "README.md"
  ],
  "sideEffects": [
    "./dist/define.js"
  ],
  "dependencies": {},
  "peerDependencies": {
    "@spreewe/core": "^0.1.0",
    "@spreewe/ui": "^0.1.0",
    "mediasoup-client": "^3.23.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
